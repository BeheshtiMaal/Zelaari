{
  "name": "codeharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test:engine": "uv run --project backend pytest backend/tests",
    "test:ui": "tsx --test tests/unit/*.test.ts",
    "test:desktop": "tsx tests/desktop.ts",
    "generate:protocol": "uv run --project backend python scripts/export_schema.py && tsx scripts/generate-protocol.ts",
    "generate:genui": "tsx scripts/generate-genui.tsx",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=electron-dist --out-extension:.js=.cjs",
    "build:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-engine.ps1",
    "desktop": "npm run generate:genui && npm run build && npm run build:electron && electron .",
    "desktop:preview": "electron .",
    "desktop:build": "npm run generate:genui && npm run build && npm run build:electron && npm run build:engine"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
